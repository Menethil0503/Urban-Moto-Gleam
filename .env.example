# Copia este archivo a .env.local y completa los valores.

# Base de datos
MONGODB_URI=mongodb://localhost:27017/urban_moto_gleam

# Panel de administración
# Genera el hash con:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync('TU_CLAVE',s,64).toString('hex'))"
ADMIN_USUARIO=urbanadmin
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de al menos 32 caracteres (firma la cookie de sesión)
AUTH_SECRET=
# Ponlo en false solo si vas a demostrar por HTTP en red local (sin HTTPS).
AUTH_COOKIE_SECURE=true

# WhatsApp vía whatsapp-web.js: no requiere variables.
# Al arrancar el servidor aparece un QR en la terminal para vincular la sesión.
